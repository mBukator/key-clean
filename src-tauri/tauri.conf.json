{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "KeyClean",
    "version": "0.1.0",
    "identifier": "io.github.mbukator.keyclean",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "create": false,
                "title": "KeyClean",
                "width": 760,
                "height": 600,
                "minWidth": 420,
                "minHeight": 520,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "publisher": "mBukator",
        "copyright": "Copyright 2026 mBukator",
        "homepage": "https://github.com/mBukator/key-clean",
        "windows": {
            "webviewInstallMode": {
                "type": "downloadBootstrapper"
            },
            "nsis": {
                "installMode": "currentUser",
                "template": "windows/installer.nsi",
                "installerHooks": "windows/keyclean.nsh"
            }
        }
    }
}
