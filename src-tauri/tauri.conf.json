{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "KeyClean",
    "version": "0.1.0",
    "identifier": "io.github.mbukator.keyclean",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "KeyClean",
                "width": 480,
                "height": 600,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
        }
    },
    "bundle": {
        "active": false,
        "targets": "nsis",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ]
    }
}
