{
    "name": "keyclean",
    "private": true,
    "version": "0.1.0",
    "license": "Apache-2.0",
    "type": "module",
    "packageManager": "bun@1.3.11",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "tauri": "tauri",
        "prepare": "husky",
        "commit": "merlin"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs,css,json,md,yml,yaml}": "prettier --write",
        "*.rs": "rustfmt --check"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.1",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "merlin-commit": "^1.0.1",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.1"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
